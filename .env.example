# Hoc_IELTS - Environment Variables Configuration

# 1. Supabase Integration (Optional - Falls back seamlessly to LocalStorage if empty)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Google Gemini API (Optional - For AI Exam Parsing and AI Writing Evaluation)
GEMINI_API_KEY=your-gemini-api-key
